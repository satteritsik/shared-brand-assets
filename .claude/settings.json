{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$SKILLSPOKE_CC/ops/memory-consolidate.py\" hook --part 1",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$SKILLSPOKE_CC/ops/memory-consolidate.py\" hook --part 2",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$SKILLSPOKE_CC/ops/memory-consolidate.py\" hook --part 3",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$SKILLSPOKE_CC/ops/memory-consolidate.py\" hook --part 4",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$SKILLSPOKE_CC/ops/indexing/gitnexus-session-start.sh\"",
            "timeout": 20
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$SKILLSPOKE_CC/.claude/hooks/pre-tool-use/linear-pull-redirect.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$SKILLSPOKE_CC/.claude/hooks/pre-tool-use/pipeline-run-blocker.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$SKILLSPOKE_CC/.claude/hooks/pre-tool-use/matrix-edit-blocker.sh\""
          }
        ]
      }
    ]
  }
}
